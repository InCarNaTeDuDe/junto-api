{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "isolatedModules": false,
    "moduleDetection": "auto",
    "noEmit": true
  },
  "include": ["./**/*.ts"]
}
