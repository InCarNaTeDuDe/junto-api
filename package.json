{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "main": "expo-router/entry",
  "scripts": {
    "ui": "npx expo start --dev-client --clear",
    "metro": "node --env-file=.env.example ./node_modules/expo/bin/cli start --clear",
    "backend": "node --inspect -r ts-node/register -r dotenv/config backend/server.ts",
    "backend2": "bash -c 'source ./config.sh && TS_NODE_PROJECT=backend/tsconfig.json node --inspect -r ts-node/register backend/server.ts'",
    "dev": "osascript -e 'tell application \"Terminal\" to do script \"cd \\\"'$PWD'\\\" && npm run metro\"' && npm run backend",
    "dev:local": "node --env-file=.env.example ./node_modules/.bin/tsx backend/server.ts",
    "dev:fsServer": "node --env-file=.env.local ./node_modules/.bin/tsx backend/server.ts & node --env-file=.env.local ./node_modules/expo/bin/cli start",
    "start:local": "npm run build && npx tsx backend/server.ts",
    "build": "npx tsx generate_assets.js && npx expo export -p web --output-dir dist && esbuild backend/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "prebuildAndroid": "APP_VARIANT=prod npx expo prebuild --platform android #--clean",
    "android": "npm run prebuildAndroid && npx expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/html-elements": "~0.13.8",
    "@google/genai": "^2.4.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "expo": "54.0.37",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.13",
    "expo-auth-session": "~7.0.11",
    "expo-constants": "18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-intent-launcher": "~13.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-speech-recognition": "^3.1.3",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^10.9.0",
    "http-proxy-middleware": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-size-matters": "^0.4.2",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "typeorm": "^1.0.0",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-css-interop": {
      "tailwindcss": "$tailwindcss"
    }
  },
  "devDependencies": {
    "@react-native/js-polyfills": "0.81.5",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.9",
    "@types/socket.io": "^3.0.1",
    "babel-preset-expo": "~54.0.11",
    "concurrently": "^10.0.3",
    "esbuild": "^0.25.0",
    "metro": "^0.83.1",
    "metro-resolver": "~0.83.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typeorm-ts-node-commonjs": "^0.3.20",
    "typescript": "~5.9.2",
    "vite": "^6.2.3"
  }
}