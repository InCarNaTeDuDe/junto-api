{
  "name": "junto-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "main": "expo-router/entry",
  "scripts": {
    "ui": "npx expo start --dev-client --clear",
    "metro": "node --env-file=.env.example ./node_modules/expo/bin/cli start --clear",
    "backend": "node --inspect -r ts-node/register -r dotenv/config backend/server.ts",
    "backend2": "APP_VARIANT=prod bash -c 'source ./config.sh && TS_NODE_PROJECT=backend/tsconfig.json node --inspect -r ts-node/register backend/server.ts'",
    "dev": "tsx backend/server.ts",
    "dev:local": "node --env-file=.env.example ./node_modules/.bin/tsx backend/server.ts",
    "dev:fsServer": "node --env-file=.env.local ./node_modules/.bin/tsx backend/server.ts & node --env-file=.env.local ./node_modules/expo/bin/cli start",
    "start:local": "npm run build && npx tsx backend/server.ts",
    "build": "npx tsx generate_assets.js && npx expo export -p web --output-dir dist && esbuild backend/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "prebuildAndroid": "APP_VARIANT=prod npx expo prebuild --platform android #--clean",
    "prebuildIos": "APP_VARIANT=prod npx expo prebuild --platform ios",
    "android": "npm run prebuildAndroid && npx expo run:android",
    "ios": "npm run prebuildIos && npx expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-google-signin/google-signin": "16.1.2",
    "expo": "~54.0.37",
    "expo-application": "~7.0.8",
    "expo-build-properties": "~1.0.9",
    "expo-constants": "~18.0.14",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-intent-launcher": "~13.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-speech-recognition": "^3.1.3",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "^0.2.7",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-size-matters": "^0.4.2",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "concurrently": "^10.0.3",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
